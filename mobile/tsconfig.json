{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": ["./*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx", ".expo/types/**/*.ts", "expo-env.d.ts"],
  // powersync/** and supabaseRepository are INERT until you run:
  //   npx expo install @powersync/react-native @powersync/op-sqlite
  // then remove them from this exclude list.
  "exclude": ["node_modules", "powersync/**", "data/supabaseRepository.ts"]
}
