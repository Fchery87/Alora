# Copy to .env (gitignored) once you've provisioned the backend.
# Until these are set, the app runs in DEMO mode on mock data (no auth, no sync).

# Supabase project (US region) — Project Settings → API
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# PowerSync instance endpoint (enables local-first sync)
EXPO_PUBLIC_POWERSYNC_URL=

# Sentry crash reporting (production only — optional). Create a project at
# sentry.io and paste its DSN. Without this, crash reporting stays disabled
# and errors degrade to console logs.
EXPO_PUBLIC_SENTRY_DSN=
