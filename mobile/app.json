{
  "expo": {
    "name": "Alora",
    "slug": "alora",
    "scheme": "alora",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.alora.mobile"
    },
    "android": {
      "package": "app.alora.mobile",
      "edgeToEdgeEnabled": true
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-font", "expo-secure-store", "expo-sqlite", "@sentry/react-native", "expo-asset"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
