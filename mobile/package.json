{
  "name": "alora",
  "version": "0.1.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit --skipLibCheck",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "export:android": "expo export --platform android --output-dir /tmp/alora-export-android",
    "export:ios": "expo export --platform ios --output-dir /tmp/alora-export-ios",
    "audit": "npm audit --omit=dev --audit-level=high",
    "test:app": "jest __tests__/app",
    "test:contracts": "jest __tests__/*.test.js",
    "test:watch": "jest --watch"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "^0.4.2",
    "@expo-google-fonts/playfair-display": "^0.4.2",
    "@op-engineering/op-sqlite": "^17.2.0",
    "@powersync/common": "^2.1.0",
    "@powersync/react-native": "^2.1.0",
    "@sentry/react-native": "~7.2.0",
    "@supabase/supabase-js": "^2.108.1",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-constants": "~18.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.8",
    "expo-haptics": "~15.0.8",
    "expo-linear-gradient": "~15.0.8",
    "expo-linking": "~8.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-router": "~6.0.0",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.8",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-worklets": "0.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "~29.7.0",
    "jest-expo": "~54.0.17",
    "prettier": "^3.9.6",
    "test-renderer": "^1.2.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
